{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "krea2_turbo_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "krea2", "device": "default" },
    "_meta": { "title": "Load CLIP" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["2", 0] },
    "_meta": { "title": "Positive Prompt" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["2", 0] },
    "_meta": { "title": "Negative Prompt" }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Init image (paint faces in the mask editor to protect them)" }
  },
  "7": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["6", 0], "upscale_method": "lanczos", "megapixels": 2, "resolution_steps": 1 },
    "_meta": { "title": "Scale to 2 MP" }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["7", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Encode" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["13", 0],
      "denoise": 0.62
    },
    "_meta": { "title": "KSampler" }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["3", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "images": ["14", 0], "filename_prefix": "ebts/image" },
    "_meta": { "title": "Save Image" }
  },
  "12": {
    "class_type": "InvertMask",
    "inputs": { "mask": ["6", 1] },
    "_meta": { "title": "Invert mask (painted faces are protected)" }
  },
  "13": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["8", 0], "mask": ["12", 0] },
    "_meta": { "title": "Apply face protection mask" }
  },
  "14": {
    "class_type": "ReActorFaceSwap",
    "inputs": {
      "enabled": true,
      "input_image": ["10", 0],
      "swap_model": "inswapper_128.onnx",
      "facedetection": "retinaface_resnet50",
      "face_restore_model": "codeformer-v0.1.0.pth",
      "face_restore_visibility": 1,
      "codeformer_weight": 0.5,
      "detect_gender_input": "no",
      "detect_gender_source": "no",
      "input_faces_index": "0",
      "source_faces_index": "0",
      "console_log_level": 1,
      "source_image": ["6", 0]
    },
    "_meta": { "title": "ReActor face swap (keep the original faces)" }
  }
}
