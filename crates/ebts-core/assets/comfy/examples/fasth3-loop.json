{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "fasth3_omniref_8step_pruned_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": { "model": ["1", 0], "shift_video": 12, "shift_audio": 3 },
    "_meta": { "title": "ModelSamplingMiniMaxH3" }
  },
  "3": {
    "class_type": "ModelAttentionBackend",
    "inputs": { "model": ["2", 0], "attention": "comfy kitchen attention" },
    "_meta": { "title": "Model Attention Backend" }
  },
  "4": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": ["3", 0],
      "selection": "vsa",
      "selection.keep_percent": 10,
      "start_percent": 0,
      "end_percent": 1,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    },
    "_meta": { "title": "Model Sparse Attention" }
  },
  "5": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" },
    "_meta": { "title": "Load CLIP" }
  },
  "6": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" },
    "_meta": { "title": "Load video VAE" }
  },
  "7": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "Load audio VAE" }
  },
  "8": {
    "class_type": "PrimitiveInt",
    "inputs": { "value": 800 },
    "_meta": { "title": "Width" }
  },
  "9": {
    "class_type": "PrimitiveInt",
    "inputs": { "value": 484 },
    "_meta": { "title": "Height" }
  },
  "10": {
    "class_type": "PrimitiveFloat",
    "inputs": { "value": 10 },
    "_meta": { "title": "Duration seconds" }
  },
  "11": {
    "class_type": "ComfyMathExpression",
    "inputs": { "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17", "values.a": ["10", 0] },
    "_meta": { "title": "Frames from seconds" }
  },
  "12": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": { "value": "" },
    "_meta": { "title": "Prompt" }
  },
  "13": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "Reference image (the poster)" }
  },
  "14": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["5", 0],
      "prompt": ["12", 0],
      "width": ["8", 0],
      "height": ["9", 0],
      "length": ["11", 1],
      "ref_image_size": "match",
      "vae": ["6", 0],
      "audio_vae": ["7", 0],
      "ref_images.ref_image_0": ["13", 0]
    },
    "_meta": { "title": "FastH3 OmniRef conditioning" }
  },
  "15": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 },
    "_meta": { "title": "RandomNoise" }
  },
  "16": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" },
    "_meta": { "title": "KSamplerSelect" }
  },
  "17": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["4", 0], "scheduler": "simple", "steps": 8, "denoise": 1 },
    "_meta": { "title": "BasicScheduler" }
  },
  "18": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["4", 0], "conditioning": ["14", 0] },
    "_meta": { "title": "Basic Guider" }
  },
  "19": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["15", 0], "guider": ["18", 0], "sampler": ["16", 0], "sigmas": ["17", 0], "latent_image": ["14", 1] },
    "_meta": { "title": "SamplerCustomAdvanced" }
  },
  "20": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["19", 0], "vae": ["6", 0] },
    "_meta": { "title": "VAE Decode" }
  },
  "21": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["19", 0], "vae": ["7", 0] },
    "_meta": { "title": "VAE Decode Audio" }
  },
  "22": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["20", 0], "fps": 24, "audio": ["21", 0], "bit_depth": 8, "color_space": "sRGB", "codec": "none" },
    "_meta": { "title": "Create Video" }
  },
  "23": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["22", 0], "filename_prefix": "ebts/video", "format": "auto", "format.codec": "auto", "codec": "auto" },
    "_meta": { "title": "Save Video" }
  }
}
